[MAIN]
fail-under=9.5

[FORMAT]
# black formats at 88; leave headroom for the long strings it will not split.
max-line-length=120

[MESSAGES CONTROL]
# broad-exception-caught: at request handlers and per-item queue boundaries a
#   service degrades to a formatted error rather than crashing. Failures that
#   must not be swallowed, such as a database write, raise past those handlers.
# wrong-import-position: shared util imports follow the sys.path shim each service needs.
disable=
    broad-exception-caught,
    wrong-import-position,
